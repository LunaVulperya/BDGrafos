<mxfile host="app.diagrams.net">
  <diagram name="Modelo de Grafo - Lavagem de Dinheiro" id="grafo1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="1) Modelo de Grafo (Esquema)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Nós -->
        <mxCell id="pessoa" value="&lt;b&gt;Pessoa&lt;/b&gt;&lt;br&gt;(Cliente PF/PJ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="conta" value="&lt;b&gt;Conta&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="disp" value="&lt;b&gt;Dispositivo&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="740" y="110" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- Arestas -->
        <mxCell id="e1" value="&lt;b&gt;TITULAR_DE&lt;/b&gt;&lt;br&gt;{desde, tipo_titular}" style="endArrow=classic;html=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="pessoa" target="conta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;ACESSADA_VIA&lt;/b&gt;&lt;br&gt;{ultimo_acesso, ip}" style="endArrow=classic;html=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="conta" target="disp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;TRANSFERIU_PARA&lt;/b&gt;&lt;br&gt;{id_tx, valor, data_hora, canal}" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#b85450;fontSize=12;exitX=0.3;exitY=0.05;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7;entryY=0.05;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="conta" target="conta">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="440" y="55" />
              <mxPoint x="530" y="55" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Propriedades -->
        <mxCell id="p1" value="&lt;b&gt;Propriedades (Pessoa)&lt;/b&gt;&lt;br&gt;cpf_cnpj: string&lt;br&gt;nome: string&lt;br&gt;tipo: PF | PJ&lt;br&gt;renda_declarada: decimal&lt;br&gt;data_cadastro: date&lt;br&gt;score_risco: float" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Propriedades (Conta)&lt;/b&gt;&lt;br&gt;id_conta: string&lt;br&gt;banco / agencia / numero&lt;br&gt;tipo: corrente | poupanca | pagamento&lt;br&gt;data_abertura: date&lt;br&gt;saldo_medio: decimal&lt;br&gt;status: ativa | bloqueada&lt;br&gt;flag_suspeita: boolean" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="370" y="230" width="230" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Propriedades (Dispositivo)&lt;/b&gt;&lt;br&gt;id_dispositivo: string&lt;br&gt;tipo: mobile | web&lt;br&gt;ip_principal: string&lt;br&gt;geolocalizacao: string" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="230" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- Exemplo -->
        <mxCell id="t2" value="2) Padrão suspeito: ciclo de contas laranjas" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="c0" value="&lt;b&gt;Conta Central&lt;/b&gt;&lt;br&gt;(origem/destino final)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="460" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ca" value="&lt;b&gt;Laranja A&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="580" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cb" value="&lt;b&gt;Laranja B&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="740" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cc" value="&lt;b&gt;Laranja C&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="120" y="580" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell id="x1" value="TRANSFERIU_PARA&lt;br&gt;R$ 50.000" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c0" target="ca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="TRANSFERIU_PARA&lt;br&gt;R$ 49.500" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ca" target="cb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="TRANSFERIU_PARA&lt;br&gt;R$ 49.000" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cb" target="cc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x4" value="TRANSFERIU_PARA&lt;br&gt;R$ 48.500" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cc" target="c0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="q" value="&lt;b&gt;Consulta de detecção (Cypher)&lt;/b&gt;&lt;br&gt;MATCH p = (c:Conta)-[:TRANSFERIU_PARA*3..6]-&amp;gt;(c)&lt;br&gt;WHERE all(r IN relationships(p) WHERE r.data_hora &amp;gt; datetime() - duration('P7D'))&lt;br&gt;RETURN p" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="330" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
